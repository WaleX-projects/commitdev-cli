#!/bin/bash

# CommitDev Color Codes matching your dashboard identity
BOLD='\033[1m'
EMERALD='\033;5;48m' # Signature mint/emerald color
DIM='\033[2m'          # Dark slate grey text
RESET='\033[0m'

# 1. RUN LOCAL HOOKS FIRST (Preserve native developer workflows)
if [ -f "./.git/hooks/pre-push.local" ]; then
    "./.git/hooks/pre-push.local" "$@"
elif [ -f "./.git/hooks/pre-push" ] && [ ! -L "./.git/hooks/pre-push" ]; then
    "./.git/hooks/pre-push" "$@"
fi

# 2. RUN COMMITDEV LOGIC
COMMIT_MSG=$(git log -1 --pretty=%B)

if [[ "${COMMIT_MSG,,}" == *"[draft]"* ]]; then
    # Professional inline notification that clears up or logs cleanly
    echo -e "  ${EMERALD}✓${RESET} ${BOLD}${EMERALD}commitdev${RESET} ${DIM}•${RESET} '[draft]' flag recognized. Spawning background watch cycle..."
    commitdev listen-for-drafts
fi
